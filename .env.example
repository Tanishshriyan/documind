APP_NAME=DocuMind AI API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
STORAGE_DIR=./storage
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_UPLOAD_SIZE_MB=25
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_EXTRACTED_CHARS=5000000
DOCUMENT_CHUNK_SIZE=1400
DOCUMENT_CHUNK_OVERLAP=180
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=32
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=45
RETRIEVAL_MIN_SIMILARITY=0.25

# Authentication: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=documind-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=documind_access
CSRF_COOKIE_NAME=documind_csrf
# false for localhost; true in HTTPS production deployments
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Optional local PostgreSQL settings for docker-compose
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind

